# Admin app env (copy to .env in this directory; never commit .env)
# API base URL. Same-origin dev default (vite proxy forwards /api to :4000):
VITE_API_URL=/api/v1
# Production/split-deploy example:
# VITE_API_URL=https://api.yourdomain.com/api/v1

# "Launch POS" button target:
VITE_POS_URL=http://localhost:5173
# Production example:
# VITE_POS_URL=https://pos.yourdomain.com
