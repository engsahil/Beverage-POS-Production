# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/beverage_pos?schema=public"

# JWT Secrets (CHANGE THESE IN PRODUCTION - use strong random strings, min 16 chars)
JWT_ACCESS_SECRET="change-this-to-a-strong-random-secret"
JWT_REFRESH_SECRET="change-this-to-another-strong-random-secret"

# Token Expiry
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Server
PORT=4000
NODE_ENV="production"

# CORS Origins (comma-separated)
CORS_ORIGINS="https://pos.yourdomain.com,https://admin.yourdomain.com"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Seed Admin Credentials (CHANGE IN PRODUCTION)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="YourStrongPassword@123"
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_BUSINESS_NAME="Your Business Name"

# Backups / File Storage (optional; local | s3)
STORAGE_PROVIDER="local"
LOCAL_STORAGE_PATH="./storage"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ENDPOINT=""

# WhatsApp (Meta Cloud API, optional)
# WHATSAPP_META_ACCESS_TOKEN=""
# WHATSAPP_META_PHONE_NUMBER_ID=""
# WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-custom-verify-token"
