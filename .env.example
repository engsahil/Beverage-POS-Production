# ============================================
# Beverage POS - Environment Variables
# ============================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# NEVER commit .env to version control.
#
# The server loads env from (first match wins per key):
#   1. .env            (repo root)
#   2. server/.env
# See server/src/lib/config.ts for the validated schema —
# unknown keys here are ignored; missing/invalid required
# keys abort server startup with a [CONFIG ERROR].

# ---------- Database (required) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/beverage_pos?schema=public

# ---------- Server ----------
PORT=4000
NODE_ENV=development
# development | production | test

# ---------- JWT Authentication (required in production) ----------
# Must each be at least 16 chars; use long random strings in production,
# e.g. the output of: openssl rand -base64 48
JWT_ACCESS_SECRET=change-this-to-a-strong-random-secret-min-16-chars
JWT_REFRESH_SECRET=change-this-to-another-strong-random-secret-min-16-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---------- CORS (comma-separated, no spaces required) ----------
# Local dev defaults (POS :5173, Admin :5174, legacy :3000/:3001):
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Production example:
# CORS_ORIGINS=https://pos.yourdomain.com,https://admin.yourdomain.com

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---------- Auth Security ----------
BCRYPT_SALT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ---------- Seed / First Admin (used by `prisma db seed`) ----------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_EMAIL=admin@beverage-pos.local
SEED_BUSINESS_NAME=Beverage POS Development

# ---------- Backups / File Storage (optional) ----------
# Options: local, s3
STORAGE_PROVIDER=local
# Local provider base directory (relative to server working dir):
LOCAL_STORAGE_PATH=./storage
# S3 provider (only when STORAGE_PROVIDER=s3):
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# (S3_ENDPOINT only for S3-compatible stores, e.g. MinIO)

# ---------- WhatsApp (Meta Cloud API, optional) ----------
# WHATSAPP_META_ACCESS_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-custom-verify-token

# ---------- Frontend (Vite) ----------
# These live in apps/admin/.env and apps/pos/.env (see those .env.example files),
# NOT here — Vite only reads VITE_* vars from the app's own directory:
#   VITE_API_URL=http://localhost:4000/api/v1   (or relative /api/v1 behind a proxy)
#   VITE_POS_URL=http://localhost:5173          (admin "Launch POS" link target)
